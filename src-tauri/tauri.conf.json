{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parafarmacia Stock",
  "version": "0.1.0",
  "identifier": "com.farmacia.parafarmacia-stock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Parafarmacia Stock",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#e9f2ec"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Control de stock de parafarmacia offline",
    "longDescription": "Aplicación nativa de Windows para gestionar inventario por estante y cuadrante. Funciona 100% offline con SQLite local.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Spanish"],
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:farmacia_real.db"]
    }
  }
}
